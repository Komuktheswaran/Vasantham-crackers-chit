<configuration>
  <system.webServer>

    <!-- Remove WebDAV so it stops swallowing PUT/DELETE with 405.
         WebDAV is registered globally on IIS and otherwise intercepts these
         verbs before iisnode sees them, and the 405 response from WebDAV
         carries no CORS headers, which surfaces as a CORS error in browsers. -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <handlers>
      <remove name="WebDAV" />
      <add name="iisnode"
           path="*"
           verb="*"
           modules="iisnode"
           scriptProcessor="server.js"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <security>
      <!-- allowDoubleEscaping permits "%2F" (encoded "/") in the URL path,
           which is required because some Customer_IDs contain "/" (e.g.
           "CD2026/1379") and end up encoded into the path segment. -->
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="104857600" maxUrl="8192" maxQueryString="4096" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <iisnode watchedFiles="web.config;*.js"
             debuggingEnabled="false"
             nodeProcessCommandLine="node --max-http-header-size=32768" />

  </system.webServer>
</configuration>
<!-- Trigger Restart v18 -->
